# Public domain (HTTPS required for iOS) used on installation URLs
DOMAIN=sign.example.com

# Upload limit in MB
MAX_IPA_MB=500
MAX_MOBILEPROVISION_MB=1
MAX_P12_MB=1

# Minutes where every file is deleted after upload (ipa, signed ipa, mobileprovision, p12)
CLEANUP_MINUTES=60

PORT=3000
DATA_DIR=./data
ZSIGN_PATH=zsign
