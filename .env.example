# Public domain (HTTPS required for iOS) used on URL installations
DOMAIN=sign.example.com

# Uploads limits in MB
MAX_IPA_MB=500
MAX_MOBILEPROVISION_MB=1
MAX_P12_MB=1

# Minutes after files are deleted (ipa, ipa firmato, mobileprovision, p12)
CLEANUP_MINUTES=60

# Rate limiting on signing (MAX=0 disables that limit)
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_IP_WINDOW_MINUTES=60
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=60

# How many proxies there are in front of the app? (for reading the real IP of the client).
# 0 = none (use the direct connection IP)
TRUST_PROXY=1

PORT=3000
DATA_DIR=./data
ZSIGN_PATH=zsign
